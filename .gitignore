# Ignore keys folder
/keys/

# Ignore WordPress config file (contains DB credentials and auth keys)
/backend/wp-config.php

# WordPress backend ignores
/backend/.htaccess
/backend/wp-content/uploads/
/backend/wp-content/cache/
/backend/wp-content/upgrade/
/backend/wp-content/blogs.dir/
/backend/*.log
/backend/error_log

# Frontend folder ignores (node_modules, dist, env files, editor files)
/Frontend/node_modules/
/Frontend/dist/
/Frontend/dist-ssr/
/Frontend/.env
/Frontend/.env.local
/Frontend/.env.production
/Frontend/*.log
/Frontend/.vscode/*
/Frontend/.idea
/Frontend/.DS_Store

# Keep frontend example env file tracked
!/Frontend/.env.example