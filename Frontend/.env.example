# Copy this file to ".env" for local development.
# For production, set VITE_WP_API_URL in your hosting provider's build
# environment and rebuild/redeploy the frontend.
#
# Use the WordPress site root (not /wp-json or /wp-json/wp/v2).
# This value is public in the browser bundle. Never put passwords, tokens,
# or other secrets in VITE_* variables.
#
# Example:
# VITE_WP_API_URL=https://your-wordpress-site.com

VITE_WP_API_URL=
