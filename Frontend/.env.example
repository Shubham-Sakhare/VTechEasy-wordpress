# ================================================================
#  VTechEasy Frontend — Environment Configuration
#  Copy this file to ".env" and fill in your values.
#  .env is gitignored — never commit it.
# ================================================================

# WordPress site root (no trailing slash, no /wp-json).
# Local dev: requests go through Vite proxy (/wp-proxy) to avoid CORS.
# Production: set this in your hosting provider's build env.
#
# Live backend:
VITE_WP_API_URL=https://vtecheasy.great-site.net/backend

# REST URL form:
#   "query" → ?rest_route=/vtech/v1/...  ← works on ALL hosts (default)
#   "path"  → /wp-json/vtech/v1/...      ← needs pretty permalinks enabled
VITE_WP_REST_MODE=query
